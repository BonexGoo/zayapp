							"rb_grip":"('open' @ ('d.robo.data.' + 'motion.frames.' + rb_frame + '.grip'))"
						},
						"if((rb_status == 1) [or] (rb_status == 2))",
						{
							"rb_cycle_seconds":"((d.robo.data.sequence.0.end - d.robo.data.sequence.0.start) / ((rb_speed / 100) * (d.robo.data.run_sequence.0.speed / 100)) + d.robo.data.run_sequence.0.wait_tenths / 10) + ((d.robo.data.sequence.1.end - d.robo.data.sequence.1.start) / ((rb_speed / 100) * (d.robo.data.run_sequence.1.speed / 100)) + d.robo.data.run_sequence.1.wait_tenths / 10) + ((d.robo.data.sequence.2.end - d.robo.data.sequence.2.start) / ((rb_speed / 100) * (d.robo.data.run_sequence.2.speed / 100)) + d.robo.data.run_sequence.2.wait_tenths / 10) + ((d.robo.data.sequence.3.end - d.robo.data.sequence.3.start) / ((rb_speed / 100) * (d.robo.data.run_sequence.3.speed / 100)) + d.robo.data.run_sequence.3.wait_tenths / 10) + ((d.robo.data.sequence.4.end - d.robo.data.sequence.4.start) / ((rb_speed / 100) * (d.robo.data.run_sequence.4.speed / 100)) + d.robo.data.run_sequence.4.wait_tenths / 10)"
						},
						{
							"rb_display_step":"rb_step"
						},
						{
							"rb_display_repeat":"rb_goal"
						},
						"else",
						{
							"rb_cycle_seconds":"((d.robo.data.sequence.0.end - d.robo.data.sequence.0.start) / ((rb_speed / 100) * (d.robo.data.sequence.0.speed / 100)) + d.robo.data.sequence.0.wait_tenths / 10) + ((d.robo.data.sequence.1.end - d.robo.data.sequence.1.start) / ((rb_speed / 100) * (d.robo.data.sequence.1.speed / 100)) + d.robo.data.sequence.1.wait_tenths / 10) + ((d.robo.data.sequence.2.end - d.robo.data.sequence.2.start) / ((rb_speed / 100) * (d.robo.data.sequence.2.speed / 100)) + d.robo.data.sequence.2.wait_tenths / 10) + ((d.robo.data.sequence.3.end - d.robo.data.sequence.3.start) / ((rb_speed / 100) * (d.robo.data.sequence.3.speed / 100)) + d.robo.data.sequence.3.wait_tenths / 10) + ((d.robo.data.sequence.4.end - d.robo.data.sequence.4.start) / ((rb_speed / 100) * (d.robo.data.sequence.4.speed / 100)) + d.robo.data.sequence.4.wait_tenths / 10)"
						},
						{
							"rb_display_step":"rb_pose_step"
						},
						{
							"rb_display_repeat":"rb_repeat"
						},
						"endif",
						{
							"rb_last_seek":"0 + rb_seek"
						},
						{
							"rb_last_wait":"0 + rb_wait"
						},
						"if(rb_toast_life <= 0)",
						{
							"rb_toast":"''"
						},
						"endif"
					]
				}
