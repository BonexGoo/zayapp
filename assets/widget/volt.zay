				"if((vc_page != vq_last_page) [and] (vq_sound == 1) [and] ((vc_page == 3) [and] (vq_last_page == 2)))",
				"playsound('sound/volt_start.mp3', d.volt.data.sound_gain.start)",
				"endif",
				"if((vc_page != vq_last_page) [and] (vq_sound == 1) [and] ((vc_page == 4) [and] (vq_last_page == 3)))",
				"playsound('sound/volt_complete.mp3', d.volt.data.sound_gain.complete)",
				"endif",
				"if((vc_page != vq_last_page) [and] (vq_sound == 1) [and] (vc_page == 5))",
				"playsound('sound/volt_page.mp3', d.volt.data.sound_gain.page)",
				"endif",
				"if((vc_page != vq_last_page) [and] (vq_sound == 1) [and] (vc_page == 6))",
				"playsound('sound/volt_select.mp3', d.volt.data.sound_gain.select)",
				"endif",
				"if((vc_page != vq_last_page) [and] (vq_sound == 1) [and] ((vc_page == 0) [and] (vq_last_page >= 0)))",
				"playsound('sound/volt_tap.mp3', d.volt.data.sound_gain.tap)",
				"endif"
			]
