					"vc_energy":"((0 + vc_soc) - d.volt.data.start_soc) * d.volt.data.capacity_kwh / 100"
				},
				{
					"vc_cents":"(vc_energy * 100) [divide] 1"
				},
				{
					"vc_int":"(vc_cents - (vc_cents % 100)) / 100"
				},
				{
					"vc_frac":"vc_cents % 100"
				},
				{
					"vc_fee":"(vc_energy * d.volt.data.rate) [divide] 1"
				},
				{
					"vc_remaining":"(((vc_target - (0 + vc_soc)) * d.volt.data.capacity_kwh / 100 / d.volt.data.power_kw * 60) [max] 0) [divide] 1"
				},
				{
					"vc_elapsed":"(vc_energy / d.volt.data.power_kw * 60) [divide] 1"
				},
				{
					"vc_thousands":"(vc_fee - (vc_fee % 1000)) / 1000"
				},
				{
					"vc_tail":"vc_fee % 1000"
				}
			],
