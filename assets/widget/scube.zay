					"sc_char_code":"'blu' @ ('d.scube.data.characters.' + sc_character + '.code')"
				},
				{
					"sc_video_title":"'' @ ('d.scube.data.videos.' + sc_selected + '.title')"
				},
				{
					"sc_video_id":"'' @ ('d.scube.data.videos.' + sc_selected + '.youtube_id')"
				},
				{
					"sc_video_place":"'' @ ('d.scube.data.videos.' + sc_selected + '.place')"
				},
				{
					"sc_video_thumb":"'r.' + ('' @ ('d.scube.data.videos.' + sc_selected + '.thumbnail'))"
				},
				{
					"sc_map_zoom":"(d.scube.data.camera.v / 100 [max] 0.8) [min] 2.1"
				},
				{
					"sc_map_s":"((sc_map_w / 1672) [min] (sc_map_h / 941)) * sc_map_zoom"
				},
				{
					"sc_map_x":"(sc_map_w - 1672 * sc_map_s) / 2 + d.scube.data.camera.x / sc_scale"
				},
				{
					"sc_map_y":"(sc_map_h - 941 * sc_map_s) / 2 + d.scube.data.camera.y / sc_scale"
				},
				{
					"sc_static_count":"d.scube.data.buildings.count"
				},
				{
					"sc_panel_age":"sc_frame_time - sc_panel_start"
				},
				{
					"sc_panel_in":"(sc_panel_age / 0.5 [max] 0) [min] 1"
				},
				{
					"sc_panel_out":"((sc_panel_age - 3.5) / 0.5 [max] 0) [min] 1"
				},
				{
					"sc_panel_p":"(sc_panel_from + (1 - sc_panel_from) * sc_panel_in * sc_panel_in * (3 - 2 * sc_panel_in)) * (1 - sc_panel_out * sc_panel_out * (3 - 2 * sc_panel_out))"
				}
			],
