						},
						{
							"kp_score_b":"(kp_cost_b / 10000) * (100 - kp_eval_priority) / 100 + kp_late_b * kp_eval_priority / 10 + 2.4 * kp_policy_stock"
						},
						{
							"kp_score_c":"(kp_cost_c / 10000) * (100 - kp_eval_priority) / 100 + kp_late_c * kp_eval_priority / 10 + 1.2 * kp_policy_stock"
						}
					]
				},
