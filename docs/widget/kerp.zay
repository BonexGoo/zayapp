							"kp_forecast_gap":"(kp_forecast_qty - kp_forecast_stock) [max] 0"
						},
						{
							"kp_policy_total":"(0 @ 'd.kerp.data.controls.policy_cost') + (0 @ 'd.kerp.data.controls.policy_deadline') + (0 @ 'd.kerp.data.controls.policy_stock')"
						},
						{
							"kp_policy_cost_n":"(100 * (0 @ 'd.kerp.data.controls.policy_cost') / (kp_policy_total [max] 1)) [divide] 1"
						},
						{
							"kp_policy_deadline_n":"((100 * (0 @ 'd.kerp.data.controls.policy_deadline') / (kp_policy_total [max] 1)) [divide] 1) [min] (100 - kp_policy_cost_n)"
						},
						{
							"kp_policy_stock_n":"(100 - kp_policy_cost_n - kp_policy_deadline_n) * (kp_policy_total > 0)"
						}
					]
				},
