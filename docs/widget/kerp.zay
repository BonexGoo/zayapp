							"kp_cost_c":"kp_calc_base + 730000 + 90000 * kp_eval_surge"
						},
						{
							"kp_late_a":"(6 + 3 * kp_eval_fail + 4 * kp_eval_surge + 7 * kp_eval_outage - kp_alloc_count - 2 * kp_transfer_count) [max] 0"
						},
						{
							"kp_late_b":"kp_late_a + 8 + 2 * kp_eval_outage"
						},
						{
							"kp_late_c":"(kp_late_a - 4 - 2 * kp_eval_fail) [max] 0"
						}
					]
				},
